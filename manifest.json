{
    "name": "Desmos Bond",
    "description": "Desmos functionality for ease of use with latex and state manipulation including expression importing/exporting.",
    "manifest_version": 3,
    "version": "1.0",
    "web_accessible_resources": [
        {
            "resources": ["desmos.js", "observers.js"],
            "matches": ["<all_urls>"]
        }
    ],
    "content_scripts": [
        {
            "matches": ["https://www.desmos.com/calculator/*"],
            "js": ["injector.js"]
        }
    ]
}
